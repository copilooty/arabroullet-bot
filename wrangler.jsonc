{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arabian-roulette-bot",
  "main": "worker.js",
  "compatibility_date": "2026-11-21",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arabian-roulette-bot",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
